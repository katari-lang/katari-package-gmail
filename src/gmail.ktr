// Gmail tools over Gmail's REST API — pure Katari, no sidecar. The tools an app hands to the model
// (`list_recent` / `read_body` / `fetch_attachment` / `send` / `modify_labels`), a `watch` daemon built on
// `poll.subscribe`, and the `provider` that serves the `credential` capability from a stored OAuth
// credential. The Bearer header, the 2xx test and the failure classification live in `google_common`.

import google_common

@"One attachment a message carries: the @filename@ the sender gave it (\"\" when it has none), the
@content_type@ the mail declares for it, the @size@ in bytes Gmail estimates, and the @attachment_id@
`fetch_attachment` takes together with the message's own id. Every part whose bytes Gmail holds behind an
`attachmentId` is listed, so a mail's inline images sit beside its real files."
data attachment(filename: string, content_type: string, size: integer, attachment_id: string)

@"A message's body as read: the @text@, and the @content_type@ of the part it came from — \"text/plain\"
for an ordinary mail, \"text/html\" when the message had no plain-text part (@text@ is then markup, tags
and all), or `null` when it had neither and @text@ is Gmail's short snippet preview."
data message_body(content_type: string | null, text: string)

@"A read message trimmed to what an assistant needs: the @id@ (the Gmail API message id — addresses
`read_body` / `modify_labels` / `fetch_attachment`), the @thread_id@ (pass it to `send` to reply inside
the same thread), the @message_id@ (the RFC822 `Message-ID` header, distinct from @id@ — pass it to
`send`'s @in_reply_to@ so a reply threads in every mail client), the @sender@ / @subject@ / @snippet@ /
@date@ as Gmail reports them, and the @attachments@ (empty for a mail with none). (The sender field is
`sender`, not `from`, because `from` is a reserved word.)"
data message(id: string, thread_id: string, message_id: string, sender: string, subject: string, snippet: string, date: string, attachments: array[attachment])

// ── the provider (the credential-name capability) ────────────────────────────

@"Get a usable Google access token — the capability the tools require (`with … credential`), served by
`provider`. Each ask resolves the provider's named credential through the runtime (`oauth.token`), which
owns the stored token and its refresh; the result is a `string of private` and flows only toward the
`Bearer` header. A credential that needs a human never throws — the ask parks the run on a
`prelude.oauth.authorize` escalation and resumes once the browser flow completes — while a transient
resolution failure throws `oauth.server_error` at the provider."
request credential() -> string of private

@"Provide the Google credential for the extent of the continuation, from @source@:
`use gmail.provider(source = credentials.oauth(name = \"google\"))` — the same stored Google credential
`google_calendar` uses, given a Gmail scope. Resolution happens on every `credential` ask, so this
provider holds no secret and keeps no state."
agent provider[R, effect E](
  source: credentials.source,
  continuation: agent (value: null) -> R with {...E, credential},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request credential() -> string of private {
      next credentials.resolve(source = source)
    }
  }
  continuation(value = null)
}

// ── shared Gmail GET ─────────────────────────────────────────────────────────

@"Issue an authenticated Gmail API call — @method@ to @url@ with @body@ (a value tree, or `null` for a
call carrying no document) — and return the reply parsed as JSON, or `null` for an empty one. Every
endpoint in this package goes through here: `google_common.call` with this package's `credential` ask
added. A non-2xx becomes `http.api_failure` (401/403 → `http.auth_error`, else `http.api_error`), with
@context@ naming the caller."
agent gmail_call(method: string, url: string, body: unknown | null, context: string) -> unknown {
  google_common.call(method = method, url = url, body = body, context = context, token = credential())
}

@"Issue an authenticated GET to a Gmail API @url@ and return its parsed JSON body — `gmail_call` with the
method fixed and no request document, which is every read in this package."
agent gmail_get(url: string, context: string) -> unknown {
  gmail_call(method = "GET", url = url, body = null, context = context)
}

// ── response parsing (read out of json) ──────────────────────────────────────

@"The value of the first @headers@ entry named @name@ (matched case-insensitively), or the empty string
when absent. Gmail returns each message header as a `{name, value}` object."
agent header_value(headers: array[unknown], name: string) -> string {
  let lowered = string.to_lower(value = name)
  let matches = array.flatten(target = for (let entry in headers) {
    next if (string.to_lower(value = json.text(target = json.field(target = entry, key = "name"))) == lowered) {
      [json.text(target = json.field(target = entry, key = "value"))]
    } else {
      []
    }
  })
  match (array.get(target = matches, index = 0)) {
    case null -> ""
    case value -> value
  }
}

@"Every attachment Gmail reports under a @payload@, walking `parts` to any depth. The test is the API's
own: a part whose `body.attachmentId` is present has its bytes held for a separate fetch and is listed,
while a part carrying inline `body.data` is not. A payload with neither an attachment id nor parts yields
the empty list."
agent collect_attachments(payload: unknown) -> array[attachment] with pure {
  let body = json.field(target = payload, key = "body")
  let size_bytes = match (json.field(target = body, key = "size")) {
    case integer(bytes) -> bytes
    case _ -> 0
  }
  let own = match (json.field(target = body, key = "attachmentId")) {
    case string(attachment_id) -> [
      attachment(
        filename = json.text(target = json.field(target = payload, key = "filename")),
        content_type = json.text(target = json.field(target = payload, key = "mimeType")),
        size = size_bytes,
        attachment_id = attachment_id,
      ),
    ]
    case _ -> []
  }
  let nested = array.flatten(target = for (let part in json.items(target = json.field(target = payload, key = "parts"))) {
    next collect_attachments(payload = part)
  })
  array.concat(left = own, right = nested)
}

@"One Gmail message resource as a `message`. Every read is totalized — a missing header or field degrades
to the empty string and a missing part tree to no attachments — so a partial resource never throws into
`watch`'s loop."
agent render_message(resource: unknown) -> message {
  let payload = json.field(target = resource, key = "payload")
  let headers = json.items(target = json.field(target = payload, key = "headers"))
  message(
    id = json.text(target = json.field(target = resource, key = "id")),
    thread_id = json.text(target = json.field(target = resource, key = "threadId")),
    message_id = header_value(headers = headers, name = "Message-ID"),
    sender = header_value(headers = headers, name = "From"),
    subject = header_value(headers = headers, name = "Subject"),
    snippet = json.text(target = json.field(target = resource, key = "snippet")),
    date = header_value(headers = headers, name = "Date"),
    attachments = collect_attachments(payload = payload),
  )
}

@"Fetch one message's resource by @id@ — a `messages.get` with `format=full`, so the headers, the snippet,
the `internalDate` and the payload's part tree all ride one reply. @context@ names the calling tool for a
failure's message."
agent get_message_resource(id: string, context: string) -> unknown {
  // `format=full`, not `metadata`: only the full format carries the payload's part tree, and the part tree
  // is the only place an attachment is described. The cost stays bounded because Google makes a part's
  // `data` and its `attachmentId` mutually exclusive, so an attachment's bytes never ride this reply.
  gmail_get(
    url = f"https://gmail.googleapis.com/gmail/v1/users/me/messages/${id}?format=full",
    context = context,
  )
}

@"Fetch one message's salient fields by @id@ — `get_message_resource` rendered through `render_message`.
`list_recent`'s per-id read."
agent get_message(id: string) -> message {
  render_message(resource = get_message_resource(id = id, context = "get_message"))
}

@"The epoch milliseconds of a message resource's `internalDate` — the instant Gmail received the message —
or `null` when the field is absent or unreadable. This is the `mark` `watch` hands each `poll.item`, so
the subscription's cursor moves on Gmail's clock and never on the poller's."
agent internal_date_milliseconds(resource: unknown) -> number | null {
  // Google renders int64 fields as JSON strings, so `internalDate` arrives as "1753500000000"; the bare
  // number is read too, since a cursor that silently stopped advancing would turn the watch mute.
  match (json.field(target = resource, key = "internalDate")) {
    case string(text) -> string.to_integer(value = text)
    case integer(value) -> value
    case _ -> null
  }
}

@"The `messages.list` URL for a Gmail search @query@ asking for at most @max_results@ ids — the first
page, which `google_common.paged` continues with `&pageToken=`. The query rides through
`string.url_encode`, so a quoted phrase, an `&` or any other reserved character arrives intact."
agent list_url(query: string, max_results: integer) -> string {
  f"https://gmail.googleapis.com/gmail/v1/users/me/messages?q=${string.url_encode(value = query)}&maxResults=${string.to_string(value = max_results)}"
}

@"The message ids of the `messages.list` @hits@, in the order Gmail returned them (newest first) — a hit
carries only `{id, threadId}`, so the salient fields need a `get_message` each."
agent message_ids(hits: array[unknown]) -> array[string] {
  for (let hit in hits) {
    next json.text(target = json.field(target = hit, key = "id"))
  }
}

@"List the ids of the messages matching a Gmail search @query@, newest first, at most @max_results@ — one
`messages.list` page. A reply without the `messages` array (no match) degrades to the empty list."
agent list_message_ids(query: string, max_results: integer) -> array[string] {
  let parsed = gmail_get(
    url = list_url(query = query, max_results = max_results),
    context = "list_message_ids",
  )
  message_ids(hits = json.items(target = json.field(target = parsed, key = "messages")))
}

// ── the tools ────────────────────────────────────────────────────────────────

@"Tool: list the most recent messages matching a Gmail search @query@ — the same query language as the
Gmail search box (\"is:unread\", \"from:alice@example.com newer_than:2d\", \"subject:invoice\") — newest
first, at most @max_results@. Each result is trimmed to id / thread / sender / subject / snippet / date,
and its @id@ addresses `read_body`, `modify_labels` and `fetch_attachment`. One message resource is
fetched per id, so a large @max_results@ costs a proportional number of calls."
agent list_recent(query: string, max_results: integer ?= 10) -> array[message] {
  for (let id in list_message_ids(query = query, max_results = max_results)) {
    next get_message(id = id)
  }
}

@"Tool: read a message's body by @id@. Returns a `message_body` — the @text@ and the @content_type@ of the
part it came from, so a reader always knows what it is holding: \"text/plain\" for an ordinary mail,
\"text/html\" with the raw markup when the message has no plain-text part (a newsletter, a receipt and
most mail a company sends; expect tags, and expect a long mail to be a long result), or `null` with
Gmail's short snippet preview when it has neither. Attachments are not part of the body — they are listed
on the `message` (`list_recent`) and fetched by `fetch_attachment`."
agent read_body(id: string) -> message_body {
  let resource = get_message_resource(id = id, context = "read_body")
  let payload = json.field(target = resource, key = "payload")
  let plain = decode_part_text(payload = payload, mime_type = "text/plain")
  // Blank, not merely empty: a `text/plain` part holding a newline and two spaces is a mail with no text
  // in it, while its HTML part may carry the whole substance.
  if (string.trim(value = plain) == "") {
    let markup = decode_part_text(payload = payload, mime_type = "text/html")
    if (string.trim(value = markup) == "") {
      message_body(content_type = null, text = json.text(target = json.field(target = resource, key = "snippet")))
    } else {
      message_body(content_type = "text/html", text = markup)
    }
  } else {
    message_body(content_type = "text/plain", text = plain)
  }
}

@"The decoded text of the first @mime_type@ part under a Gmail @payload@ — its base64url `body.data`
decoded when the payload is that type, otherwise the first such descendant found by walking `parts`. No
such part anywhere returns the empty string. Internal to `read_body`, which fixes the preference order."
agent decode_part_text(payload: unknown, mime_type: string) -> string with pure {
  match (json.field(target = payload, key = "mimeType")) {
    case string(part_mime_type) -> {
      if (part_mime_type == mime_type) {
        string.from_base64url(value = json.text(target = json.field(target = json.field(target = payload, key = "body"), key = "data")))
      } else {
        let found = for (let part in json.items(target = json.field(target = payload, key = "parts"))) {
          next decode_part_text(payload = part, mime_type = mime_type)
        }
        let non_empty = array.flatten(target = for (let text in found) {
          next if (string.trim(value = text) == "") { [] } else { [text] }
        })
        match (array.get(target = non_empty, index = 0)) {
          case null -> ""
          case first -> first
        }
      }
    }
    case _ -> ""
  }
}

@"Translate a base64url payload (the `-_` alphabet, padding often omitted) into the standard base64
`files.from_base64` accepts, which validates its alphabet strictly. Deliberately not
`string.from_base64url`: that decodes to text, and decoding a PDF's or an image's bytes as UTF-8 mangles
them undetectably. Internal to `fetch_attachment`."
agent base64url_to_base64(value: string) -> string with pure {
  let translated = string.replace(
    value = string.replace(value = value, search = "-", replacement = "+"),
    search = "_",
    replacement = "/",
  )
  // Restore the `=` padding base64url drops; the strict decoder requires a length that is a multiple of
  // four. A remainder of 1 is not a base64 length at all, so it is left to fail loudly at the decoder
  // rather than being padded into some other, wrong set of bytes.
  match (string.length(value = translated) % 4) {
    case 2 -> translated ++ "=="
    case 3 -> translated ++ "="
    case _ -> translated
  }
}

@"The content type the message declares for the attachment @attachment_id@ names on message @id@, or \"\"
when that message reports no such attachment. The `attachments.get` reply carries no MIME type at all, and
a `file` recording none cannot be shown to a model as an image, so `fetch_attachment` spends one message
read to recover it. Internal to `fetch_attachment`."
agent attachment_content_type(id: string, attachment_id: string) -> string {
  let payload = json.field(target = get_message_resource(id = id, context = "fetch_attachment"), key = "payload")
  let declared = array.flatten(target = for (let entry in collect_attachments(payload = payload)) {
    next if (entry.attachment_id == attachment_id) { [entry.content_type] } else { [] }
  })
  match (array.get(target = declared, index = 0)) {
    case null -> ""
    case found -> found
  }
}

@"Tool: fetch one of a message's attachments and return it as a file. @id@ is the message's id (a
`list_recent` result's @id@, not its @message_id@) and @attachment_id@ is the @attachment_id@ of one entry
in that message's @attachments@ list. Pass @content_type@ too — the very `content_type` that listing
showed beside the attachment id: Gmail regenerates attachment ids on every message read, so the fallback
re-read may match no part and hand back an untyped file a receiver sees as a generic `.bin`. The result is
a `file` handle whose bytes stay runtime-side, so it can be passed straight to any other tool you hold
that takes a file while the payload never enters the conversation. The file carries a type but no name, so
a receiver sees a generated one like `file-1.pdf` — say the real filename in your message when it matters.
This only reads, and one call fetches one attachment, so ask for the one you actually need. A payload that
comes back corrupt throws `files.malformed_base64`; a non-2xx reply raises `http.api_failure`
(`http.auth_error` | `http.api_error`)."
agent fetch_attachment(id: string, attachment_id: string, @"The content type the listing declared for this attachment; omit to make this agent re-read the message and look it up (unreliable — see above)." content_type: string | null ?= null) -> file {
  let content_type = match (content_type) {
    case null -> attachment_content_type(id = id, attachment_id = attachment_id)
    case declared -> declared
  }
  let resource = gmail_get(
    url = f"https://gmail.googleapis.com/gmail/v1/users/me/messages/${id}/attachments/${attachment_id}",
    context = "fetch_attachment",
  )
  // `files.from_base64` produces a blob: the bytes go to the project's blob store and the value plane
  // carries the slim handle alone, so an attachment never rides a durable call record or a trace.
  files.from_base64(
    content = base64url_to_base64(value = json.text(target = json.field(target = resource, key = "data"))),
    content_type = content_type,
  )
}

@"Tool: send a plain-text email from the authenticated user. @to@ is the recipient address, @subject@ the
subject line, @body@ the message body; it returns the sent message's id, and a sent mail cannot be taken
back. To reply inside a conversation, pass @thread_id@ (a message's `thread_id`, so Gmail files the reply
in that thread) and @in_reply_to@ (that message's `message_id` — its RFC822 `Message-ID` header, not its
`id`), which become the `In-Reply-To` and `References` headers so a mail client threads it too; both
default to `null`, a fresh send. Compose the @subject@ yourself — prefix \"Re: \" for a reply. The RFC822
message is base64url-encoded into the ordinary `messages.send` `raw` field; a non-2xx reply raises
`http.api_failure` (`http.auth_error` | `http.api_error`)."
agent send(
  to: string,
  subject: string,
  body: string,
  thread_id: string | null ?= null,
  in_reply_to: string | null ?= null,
) -> string {
  // The parent's own References chain is not exposed, so `References` is just the parent — RFC 5322's
  // accepted fallback when the ancestor chain is unknown.
  let reply_headers = match (in_reply_to) {
    case null -> ""
    case parent -> f"In-Reply-To: ${parent}\r\nReferences: ${parent}\r\n"
  }
  let raw = f"To: ${to}\r\nSubject: ${subject}\r\n${reply_headers}\r\n${body}"
  // An absent `threadId` starts a new conversation, so an omitted argument is a smaller request rather
  // than a blank field.
  let payload = record.set_if[unknown](
    target = { raw = string.to_base64url(value = raw) },
    key = "threadId",
    value = thread_id,
  )
  json.text(target = json.field(
    target = gmail_call(
      method = "POST",
      url = "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
      body = payload,
      context = "send",
    ),
    key = "id",
  ))
}

@"Tool: change the labels on message @id@ — add the label ids in @add@, remove those in @remove@. The
common use is marking a message read by removing \"UNREAD\", or filing it by adding a label id. Both lists
default to empty (an empty call is a no-op at the API), and the call returns null; a non-2xx reply raises
`http.api_failure` (`http.auth_error` | `http.api_error`)."
agent modify_labels(id: string, add: array[string] ?= [], remove: array[string] ?= []) -> null {
  let payload: record[unknown] = { addLabelIds = add, removeLabelIds = remove }
  let _ = gmail_call(
    method = "POST",
    url = f"https://gmail.googleapis.com/gmail/v1/users/me/messages/${id}/modify",
    body = payload,
    context = "modify_labels",
  )
  null
}

// ── the watch daemon ─────────────────────────────────────────────────────────

@"Every message id matching @query@, across all result pages, oldest first — `watch`'s per-poll listing.
Gmail lists matches newest first and offers no ascending order, so the full drain is reversed: a
`poll.subscribe` cursor may only pass mail that has actually been delivered, and a listing cut off at a
cap would strand everything below it forever. Internal to `watch`."
agent list_all_message_ids(query: string) -> array[string] {
  let hits = google_common.paged(
    base_url = list_url(query = query, max_results = 500),
    item_key = "messages",
    context = "watch",
    token = credential(),
  )
  array.reverse(target = message_ids(hits = hits))
}

@"Watch the mailbox for mail that arrives matching a Gmail search @query@ and deliver each new message
once, oldest first, to @deliver_to@ — `poll.subscribe` under a Gmail adapter, so it composes under
`parallel [ … ]` and never resolves (`-> never`). Every @poll_interval_milliseconds@ it searches
`<@query@> after:<cursor>`, hands each unseen message to @deliver_to@, and moves the cursor to that
message's own arrival instant (Gmail's `internalDate`, never the poller's clock). @deliver_to@'s effects
@E@ flow to the caller's handlers unchanged, so a delivery may itself reply or label.

Delivery is at-least-once: the commit lands only after a delivery returns, so a crash or a throw in
between re-delivers exactly that message on the next tick. Build exactly-once at the destination by making
the delivery idempotent on the `message`'s @id@.

@cursor_at@ decides what a restart does and has no default. `poll.resume(key = ...)` keeps the cursor in
the store, so the mail that arrived while the watch was down is delivered, oldest first, on the tick after
it comes back; `poll.fresh()` re-primes on every activation and skips the downtime for good. Two watches
sharing one key overwrite each other's cursor.

What it reports is arrival, not matching: the mail already in the mailbox when the subscription starts is
never delivered, and mail that comes to match @query@ later — an old message you star or mark unread — is
not either, because the search never looks below the cursor. `list_recent` answers that question instead.

No retry is built in — a poll failure propagates and kills the subscription — so compose resilience by
wrapping the watch in a supervise provider. The first poll is one @poll_interval_milliseconds@ in, so a
message arriving just after the watch starts is pending rather than lost."
agent watch[effect E](
  @"The Gmail search to watch, in the ordinary search-box language." query: string,
  @"How often to poll, in milliseconds." poll_interval_milliseconds: number,
  @"Where the cursor lives between activations: `poll.resume(key = ...)` to deliver the downtime after a restart, `poll.fresh()` to skip it." cursor_at: poll.continuity,
  @"Called once per newly arrived message; its effects flow to the caller's handlers unchanged." deliver_to: agent (value: message) -> null with E,
) -> never with E | io | credential | store.get | store.set | prelude.throw[http.api_failure | http.fetch_error | json.parse_error] {
  // A local agent because it captures @query@; its `credential` and throws flow out to the caller.
  agent fetch(since: number, tick: number) -> array[poll.item[message]] with credential | io | prelude.throw[http.api_failure | http.fetch_error | json.parse_error] {
    // Gmail's `after:` takes whole seconds, so the millisecond cursor floors here — the one place the two
    // clocks meet. The 1000 ms overlap below covers the conversion whichever way Gmail reads `after:` (it
    // does not document whether the boundary is inclusive).
    let arrivals = f"${query} after:${string.to_string(value = math.floor(value = since / 1000))}"
    for (let id in list_all_message_ids(query = arrivals)) {
      let resource = get_message_resource(id = id, context = "watch")
      // An unreadable `internalDate` is read as the tick: the item is still committed, while the cursor
      // cannot travel past this tick anyway, so no other mail is stepped over.
      let mark = match (internal_date_milliseconds(resource = resource)) {
        case null -> tick
        case parsed -> parsed
      }
      next poll.item(key = id, mark = mark, value = render_message(resource = resource))
    }
  }
  poll.subscribe[message](
    schedule = time.interval(milliseconds = poll_interval_milliseconds),
    // Gmail has a monotone receive clock, so the memory is a floor plus the ids at or above it —
    // constant-size however long the watch runs.
    dedup = poll.watermark(overlap = 1000),
    backlog = poll.skip_backlog(),
    continuity = cursor_at,
    fetch = fetch,
    deliver_to = deliver_to,
  )
}

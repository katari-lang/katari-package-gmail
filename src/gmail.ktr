// A self-contained Gmail tool set — pure Katari, no sidecar: every Gmail API call is `http.fetch` with the
// request built and the reply parsed as `json` in Katari, and authentication is the runtime's credentials
// core, reached through `oauth.token`. The tools an app hands to the model (`list_recent` / `read_body` /
// `fetch_attachment` / `send` / `modify_labels`), a notification watcher (`watch`) that composes under
// `parallel [ … ]`, and the provider that makes wiring it a one-liner:
// `use gmail.provider(source = credentials.oauth(name = "google"))`.
//
// Authentication is identical to the `google_calendar` package (a shared Google OAuth credential): the
// provider holds NO secret and keeps NO cache. It takes a credential NAME and serves `credential` by
// resolving that name through the runtime (`oauth.token`) — the operator registers the Google OAuth client
// once (with a Gmail scope) and logs in through the runtime-hosted browser flow, after which the runtime
// owns the token material end to end. The resolved access token is a `string of private` — it flows only
// toward the `Authorization: Bearer` header and is redacted at every user-facing boundary.
//
// Failure has THREE meanings, each decided at its own boundary. (1) A credential that needs a HUMAN —
// never authorized, or refresh-dead — is never an error: `oauth.token` PARKS the run on a
// `prelude.oauth.authorize` escalation and resumes once the browser flow completes; this package neither
// sees nor classifies that state. (2) A transient token-resolution failure (a network error, a
// token-endpoint 5xx) is `oauth.server_error`, thrown at the provider. (3) The Gmail API's own failures are
// this package's two-variant sum (`gmail_error = auth_error | api_error`), classified once in
// `classify_api_error`: a 401/403 is `auth_error` (Google rejected the resolved token — a replay
// re-resolves it, and a credential the runtime cannot refresh parks as a re-authorization prompt), every
// other non-2xx is `api_error` (a bad request, a quota or server error — a plain backoff's case).
//
// The `watch` daemon is built on `time.watch` with an interval schedule, NOT a `time.sleep` recursion: a
// per-poll recursion accumulates a durable delegation frame per tick, growing without bound over a daemon's
// lifetime, whereas `time.watch`'s reactor owns the loop and ticks add no depth. What it carries between
// ticks is a WATERMARK, not a set of seen ids: the watch primes a cursor at the instant it starts and each
// tick searches `<query> after:<cursor>`, so the mail already sitting in the mailbox is never "new" (the
// backlog is below the cursor) and a message that leaves the result set and re-enters it never comes back
// (the cursor has passed it). The cursor advances by the DELIVERED messages' own `internalDate` — Gmail's
// receive clock — never by the poller's, so a slow tick, a long turn or a skewed clock cannot step over
// mail; the poller's clock enters once, to cap how far one tick may carry the cursor, which can only hold
// it back. Its only companion memory is the handful of ids delivered at the cursor's own second, which is
// what makes the second-granular `after:` boundary safe in either direction. Delivery is AT-LEAST-ONCE: a crash
// between one message's delivery and its commit re-delivers that message, nothing else.
//
// Both directions use the stdlib string codecs added for exactly this (`string.to_base64url` /
// `string.from_base64url` / `string.url_encode`): `send` base64url-encodes the RFC822 message into the
// ordinary `messages.send` `raw` field, `read_body` base64url-decodes the wanted part's `body.data` to
// real text (the `text/plain` part, else the `text/html` part's markup, else the snippet — and it returns
// WHICH one it got as a `message_body`'s content type, so rendering the difference is the app's business
// and not this package's), and the `q` query is percent-encoded in full. An ATTACHMENT is bytes rather than text and so takes the other road:
// `fetch_attachment` hands its base64url payload to `files.from_base64` (through `base64url_to_base64`,
// because the blob producer takes the standard alphabet) and returns a `file`, so the bytes go to the
// project's blob store and only the slim handle rides the value plane.

@"An authentication failure: a Gmail API call came back 401/403 — Google rejected the access token the
runtime resolved (revoked before its stored expiry, or scoped too narrowly for the call). Retrying the SAME
token does not help, but replaying the call recovers without any app-owned escalation: catch it in a
converter that signals `replay.interrupted` — the re-run asks `credential` afresh, the runtime refreshes the
credential once its stored lifetime passes, and a credential the runtime cannot refresh parks the run on a
`prelude.oauth.authorize` escalation (the admin console's re-authorization prompt) instead of failing.
`message` carries the status and the server's body."
data auth_error(message: string)

@"A Gmail API call failed for a non-authentication reason: the endpoint returned a non-2xx status that is
not 401/403 (a bad request, a not-found message, a quota or server error). `message` carries the status and
the server's body so the model can read what went wrong and adjust. Distinct from `auth_error` so a program
can tell a request the service faulted on (back off and replay as-is) from a token Google rejected (the
replay's re-resolution is what fixes it)."
data api_error(message: string)

// A Gmail failure: an authentication failure or a plain API failure. (Type synonyms take no docs; classified
// once in `classify_api_error` — 401/403 is `auth_error`, everything else `api_error`.)
type gmail_error = auth_error | api_error

@"One attachment a message carries, as Gmail describes it: the @filename@ the sender gave it (\"\" when it
has none, which an inline image often does), the @content_type@ the mail declares for it (e.g.
\"application/pdf\", \"image/png\"), the @size@ in bytes Gmail estimates for it, and the @attachment_id@
that `fetch_attachment` fetches it by — together with the MESSAGE's id, since an attachment id names a
part of one particular message. Plain data: knowing an attachment exists is one thing, and asking for its
bytes is another (`fetch_attachment`), so a mail can be read and judged without downloading anything.
Every part whose bytes Gmail holds behind an `attachmentId` is listed, which puts a mail's INLINE images
(the logo in an HTML signature) in the list beside its real files — the mail declares no difference
between them, so the list reports what is there and leaves what is worth fetching to its reader."
data attachment(filename: string, content_type: string, size: integer, attachment_id: string)

@"A message's body as read: the @text@ itself, and the @content_type@ of the part that text came from —
\"text/plain\" for an ordinary mail, \"text/html\" when the message had no plain-text part (@text@ is then
MARKUP, tags and all), or \"\" when it had neither and @text@ is Gmail's short SNIPPET preview rather than
a body at all. The type is a FIELD, not a sentence prefixed to the text: an announcement written into the
prose would fix one consumer's presentation inside this package, where nobody can inspect or override it
and every other consumer has to parse it back out — a reader that wants to strip the tags, or render the
markup, or ignore the distinction entirely needs the type as data. (\"\" for \"none\" is the convention
`files.content_type` and `header_value` already use here.)"
data message_body(content_type: string, text: string)

@"A read message trimmed to what an assistant needs: the @id@ (the Gmail API message id — addresses
`read_body` / `modify_labels` / `fetch_attachment`), the @thread_id@ (the conversation it belongs to —
pass it to `send` to reply inside the same thread), the @message_id@ (the RFC822 `Message-ID` header, e.g.
\"<abc@mail.gmail.com>\" — DISTINCT from @id@; pass it to `send`'s @in_reply_to@ so a reply threads in
every mail client), the @sender@ (the raw `From` header), the @subject@ line, the @snippet@ (Gmail's short
plain-text preview of the message), the @date@ (the raw `Date` header, e.g.
\"Mon, 21 Jul 2026 09:15:00 +0900\") and the @attachments@ (one `attachment` entry per attached part,
empty for a mail with none — each entry's @attachment_id@, with this message's @id@, is what
`fetch_attachment` takes). (The sender field is `sender`, not `from`, because `from` is a reserved word.)"
data message(id: string, thread_id: string, message_id: string, sender: string, subject: string, snippet: string, date: string, attachments: array[attachment])

// ── the provider (the credential-name capability) ────────────────────────────

@"Get a usable Google access token, served by `provider` for the extent of a continuation — the capability
the tools require (`with … credential`). Each ask resolves the provider's named credential through the
runtime (`oauth.token`): the runtime returns the stored token while its recorded lifetime holds and refreshes
it against the stored token endpoint once due, so no token bookkeeping lives in the program. The token is a
`string of private` — it flows only toward a submission sink (the `Bearer` header). A credential that needs a
human (never authorized, or refresh-dead) never throws: the ask PARKS the run on a `prelude.oauth.authorize`
escalation and resumes once the browser flow completes. A transient resolution failure throws
`oauth.server_error` at the provider."
request credential() -> string of private

// On a downstream 401/403 (an access token revoked BEFORE its stored expiry): there is no invalidation
// channel here, and none is needed. The runtime keeps serving the stored token while its clock says valid, so
// a mid-lifetime revocation surfaces as `auth_error` on every call for up to one access-token lifetime (≈ an
// hour for Google) — the bounded worst case. A converter that turns `auth_error` into `replay.interrupted`
// makes the recovery automatic: each re-run asks `credential` afresh, the resolution refreshes once the stored
// lifetime passes, and a refresh the token endpoint refuses parks the run as a re-authorization prompt.
@"Provide the Google credential for the extent of the continuation, from @source@ — the
credentials-unification shape: `use gmail.provider(source = credentials.oauth(name = \"google\"))`
(the same stored Google credential the `google_calendar` package uses, given a Gmail scope). Resolution
happens on EVERY `credential` ask (the runtime owns the token material, its cache and its refresh, so this
provider holds no secret and keeps no state); an unauthorized oauth credential parks the run on a
`prelude.oauth.authorize` escalation rather than failing, and a transient resolution failure throws at the
asking call."
agent provider[R, effect E](
  source: credentials.source,
  continuation: agent (value: null) -> R with {...E, credential},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request credential() -> string of private {
      next credentials.resolve(source = source)
    }
  }
  continuation(value = null)
}

@"The `Authorization: Bearer <token>` header every Gmail API call carries. The token is a
`string of private` (the runtime-resolved credential); concatenation propagates the taint, and the header
record is a private-capable submission sink, so the secret leaves only toward Google's server."
agent bearer(token: string of private) -> record[string of private] {
  { "Authorization" = "Bearer " ++ token }
}

@"Classify a failed Gmail API response into the error sum, at the ONE boundary where the split is decided.
A 401 or 403 is an authentication failure — Google rejected the resolved access token (revoked, or scoped
too narrowly) — surfaced as `auth_error`, which a replay converter turns into a fresh token resolution (and,
when the credential is refresh-dead, the runtime's re-authorization park). Every other non-2xx is an
`api_error`. (403 is read as auth even though Google also returns it for quota exhaustion; the
access-rejection reading is the one worth composing the re-resolution around, and a quota 403 that is
replayed simply fails again.) @context@ names the call for the message."
agent classify_api_error(context: string, status: integer, body: string) -> gmail_error {
  let status_text = string.to_string(value = status)
  let message = f"${context} failed (status ${status_text}): ${body}"
  match (status) {
    case 401 -> auth_error(message = message)
    case 403 -> auth_error(message = message)
    case _ -> api_error(message = message)
  }
}

// ── shared Gmail GET ─────────────────────────────────────────────────────────

@"Issue an authenticated GET to a Gmail API @url@ and return its parsed JSON body — the one place the
`Bearer` header, the 2xx check and the error classification live, shared by every read (`list_recent`,
`read_body`, `get_message`, and `watch`'s poll). A non-2xx becomes `classify_api_error(@context@, ...)`
(401/403 → `auth_error`, else `api_error`); @context@ names the caller for the message."
agent gmail_get(url: string, context: string) -> unknown {
  let response = http.fetch(
    url = url,
    method = "GET",
    headers = bearer(token = credential()),
    body = http.text(content = ""),
  )
  if (response.status >= 200 && response.status < 300) {
    json.parse(text = response.body)
  } else {
    prelude.throw(error = classify_api_error(context = context, status = response.status, body = response.body))
  }
}

// ── response parsing (read out of json) ──────────────────────────────────────

@"The value of the first message header named @name@ (matched case-insensitively) in the @headers@ array of
`{name, value}` objects, or the empty string when absent. Gmail returns each requested metadata header as
such an object; this is the total lookup `render_message` reads From / Subject / Date through."
agent header_value(headers: array[unknown], name: string) -> string {
  let lowered = string.to_lower(value = name)
  let matches = array.flatten(target = for (let entry in headers) {
    next if (string.to_lower(value = json.text(target = json.field(target = entry, key = "name"))) == lowered) {
      [json.text(target = json.field(target = entry, key = "value"))]
    } else {
      []
    }
  })
  match (array.get(target = matches, index = 0)) {
    case null -> ""
    case value -> value
  }
}

@"Every attachment Gmail reports under a @payload@, walking `parts` to any depth — a `multipart/mixed`
message keeps its files next to a nested `multipart/alternative` text, and a forwarded mail nests deeper
still. The test is the one the API itself makes: a part whose `body.attachmentId` is present is a part
whose bytes Gmail is holding for a separate fetch, so it is listed, while a part carrying inline
`body.data` (the text of the mail) is not. Total — a payload with neither an attachment id nor parts
yields the empty list. Internal to `render_message` and `fetch_attachment`."
agent collect_attachments(payload: unknown) -> array[attachment] with pure {
  let body = json.field(target = payload, key = "body")
  // A size Gmail did not report reads as 0 rather than failing the message: the size only informs a
  // reader's judgement about whether to fetch, whereas the id is what fetching actually needs.
  let size_bytes = match (json.field(target = body, key = "size")) {
    case integer(bytes) -> bytes
    case _ -> 0
  }
  let own = match (json.field(target = body, key = "attachmentId")) {
    case string(attachment_id) -> [
      attachment(
        filename = json.text(target = json.field(target = payload, key = "filename")),
        content_type = json.text(target = json.field(target = payload, key = "mimeType")),
        size = size_bytes,
        attachment_id = attachment_id,
      ),
    ]
    case _ -> []
  }
  let nested = array.flatten(target = for (let part in json.items(target = json.field(target = payload, key = "parts"))) {
    next collect_attachments(payload = part)
  })
  array.concat(left = own, right = nested)
}

@"One Gmail message resource as a `message`. The From / Subject / Date / Message-ID come from the
`payload.headers` array (looked up by name via `header_value`); the id, thread id and snippet come off the
resource directly; the attachments come from the same payload's part tree (`collect_attachments`), which
is why `get_message_resource` reads the FULL format. Every read is totalized — a missing header or field
degrades to the empty string and a missing part tree to no attachments — so a partial resource never
throws into `watch`'s loop."
agent render_message(resource: unknown) -> message {
  let payload = json.field(target = resource, key = "payload")
  let headers = json.items(target = json.field(target = payload, key = "headers"))
  message(
    id = json.text(target = json.field(target = resource, key = "id")),
    thread_id = json.text(target = json.field(target = resource, key = "threadId")),
    message_id = header_value(headers = headers, name = "Message-ID"),
    sender = header_value(headers = headers, name = "From"),
    subject = header_value(headers = headers, name = "Subject"),
    snippet = json.text(target = json.field(target = resource, key = "snippet")),
    date = header_value(headers = headers, name = "Date"),
    attachments = collect_attachments(payload = payload),
  )
}

@"Fetch one message's RESOURCE by @id@ — a `messages.get` with `format=full`; the headers
(From / Subject / Date / Message-ID), the snippet, the `internalDate` and the payload's part tree all ride
that one reply. The ONE place the per-message endpoint's shape lives, shared by `get_message`, `read_body`,
`fetch_attachment`'s content-type lookup and `watch` — which needs the same reply's `internalDate` for its
watermark and so reads the resource rather than the rendered `message`. @context@ names the calling tool
for a failure's message."
agent get_message_resource(id: string, context: string) -> unknown {
  // FULL, not `metadata`: the metadata format answers with the message-level fields and the requested
  // headers and NOTHING of the payload's part tree, and the part tree is the only place an attachment is
  // described. Read as metadata, every message's `attachments` would come back empty however many files
  // the mail carried — a quiet lie about the mail rather than an error, which is the failure worth paying
  // to avoid.
  //
  // What that costs is BOUNDED, which matters because `watch` runs this per new message on every poll: a
  // part's bytes and its `attachmentId` are mutually exclusive in the API's own contract — "when present,
  // [attachmentId] contains the ID of an external attachment that can be retrieved in a separate
  // messages.attachments.get request; when not present, the entire content of the message part body is
  // contained in the data field". So an attachment's bytes NEVER ride this reply; a 10 MB PDF costs its
  // one part-tree entry per read and nothing more, and only `fetch_attachment` ever moves it. The price
  // is the message's own TEXT bodies coming along beside the headers — a bigger reply per message, not a
  // download per poll.
  gmail_get(
    url = f"https://gmail.googleapis.com/gmail/v1/users/me/messages/${id}?format=full",
    context = context,
  )
}

@"Fetch one message's salient fields by @id@ — `get_message_resource` rendered through `render_message`,
so a missing header degrades to the empty string rather than throwing. `list_recent`'s per-id read."
agent get_message(id: string) -> message {
  render_message(resource = get_message_resource(id = id, context = "get_message"))
}

@"The epoch SECOND of a message resource's `internalDate` — the instant GMAIL received the message, which
the API carries as a string of epoch milliseconds — or `null` when the field is absent or unreadable.
`watch`'s cursor is the maximum of these over the messages it has delivered, so the cursor tracks Google's
own receive clock instead of the poller's: nothing arriving between a tick's listing and its deliveries can
be stepped over."
agent internal_date_seconds(resource: unknown) -> integer | null {
  // Google renders int64 fields as JSON STRINGS, so `internalDate` arrives as "1753500000000" — but the
  // bare-number shape is read too, because a cursor that silently stopped advancing on a shape change would
  // turn the watch mute rather than loud, the hardest failure to notice.
  let milliseconds = match (json.field(target = resource, key = "internalDate")) {
    case string(text) -> string.to_integer(value = text)
    case integer(value) -> value
    case _ -> null
  }
  match (milliseconds) {
    case null -> null
    case parsed -> math.floor(value = parsed / 1000)
  }
}

@"Percent-encode a Gmail search @value@ for the `q` URL parameter — a full component encoder
(`string.url_encode`), so a quoted phrase, an `&`, or any reserved character in the query rides
intact, not just spaces."
agent encode_query(value: string) -> string {
  string.url_encode(value = value)
}

@"The `messages.list` URL for a Gmail search @query@ asking for at most @max_results@ ids, continuing from
@page_token@ when one is given (`null` asks for the first page). The one place the search endpoint's shape
lives, shared by `list_recent`'s single page and `watch`'s full drain."
agent list_url(query: string, max_results: integer, page_token: string | null) -> string {
  let base = f"https://gmail.googleapis.com/gmail/v1/users/me/messages?q=${encode_query(value = query)}&maxResults=${string.to_string(value = max_results)}"
  match (page_token) {
    case null -> base
    case token -> base ++ "&pageToken=" ++ token
  }
}

@"The message ids on one `messages.list` page, in the order Gmail returned them (newest first) — the reply
carries only `{id, threadId}` per hit, so the salient fields need a `get_message` each. A page without the
`messages` array (no match) degrades to the empty list."
agent page_message_ids(parsed: unknown) -> array[string] {
  for (let item in json.items(target = json.field(target = parsed, key = "messages"))) {
    next json.text(target = json.field(target = item, key = "id"))
  }
}

@"List the ids of the messages matching a Gmail search @query@, newest first, at most @max_results@ — one
`messages.list` page. `list_recent`'s listing; `watch` drains every page instead, because a cursor may only
pass mail that has actually been seen."
agent list_message_ids(query: string, max_results: integer) -> array[string] {
  page_message_ids(parsed = gmail_get(
    url = list_url(query = query, max_results = max_results, page_token = null),
    context = "list_message_ids",
  ))
}

// ── the tools ────────────────────────────────────────────────────────────────

@"Tool: list the most recent messages matching a Gmail search @query@ — the same query language as the
Gmail search box (\"is:unread\", \"from:alice@example.com newer_than:2d\", \"subject:invoice\") — newest
first, at most @max_results@. Each result is trimmed to id / thread / sender / subject / snippet / date, small
enough to feed straight back to the model, and its @id@ addresses `read_body` and `modify_labels`. A message
resource is fetched per id for its headers, so a large @max_results@ is a proportional number of calls."
agent list_recent(query: string, max_results: integer ?= 10) -> array[message] {
  for (let id in list_message_ids(query = query, max_results = max_results)) {
    next get_message(id = id)
  }
}

@"Tool: read a message's body by @id@. Returns the body as a `message_body` — the @text@ and the
@content_type@ of the part it came from — so a reader always knows WHAT it is holding. The preference is
`text/plain` (the `payload.body.data`, or for a `multipart/*` message the first `text/plain` descendant's,
base64url-decoded to real text); a message with no plain-text part anywhere — an HTML-only mail, which a
newsletter, a receipt and most mail a company sends all are — comes back with @content_type@
\"text/html\" and its MARKUP as the text, because that markup is the whole substance of such a mail and
reads perfectly well, whereas nothing at all would report a full message as blank. Expect tags in that
case, and expect a long HTML mail to be a long result. A message with neither part comes back with
@content_type@ \"\" and Gmail's SNIPPET — the short plain-text preview the API carries on every resource —
so the read is never empty-handed. ATTACHMENTS are not part of the body: they are listed on the `message`
(`list_recent`) and fetched by `fetch_attachment`."
agent read_body(id: string) -> message_body {
  let resource = get_message_resource(id = id, context = "read_body")
  let payload = json.field(target = resource, key = "payload")
  let plain = decode_part_text(payload = payload, mime_type = "text/plain")
  if (string.is_blank(value = plain)) {
    let markup = decode_part_text(payload = payload, mime_type = "text/html")
    // WHY the markup rather than the snippet: an HTML-only mail keeps its entire content in the
    // `text/html` part, and a model reads HTML as well as it reads prose — so answering "what did that
    // newsletter say" with two lines of preview, or with nothing, is wrong in the quiet way that looks
    // like an empty mail. What makes the fallback visible is the content type RIDING ALONGSIDE the text:
    // the caller dispatches on data it was handed, instead of on an announcement this package would
    // otherwise have written into the prose for it.
    if (string.is_blank(value = markup)) {
      message_body(content_type = "", text = json.text(target = json.field(target = resource, key = "snippet")))
    } else {
      message_body(content_type = "text/html", text = markup)
    }
  } else {
    message_body(content_type = "text/plain", text = plain)
  }
}

@"The decoded text of the first @mime_type@ part under a Gmail @payload@ — its `body.data` (base64url)
decoded when the payload IS that type, otherwise the first such descendant found by walking `parts` (a
`multipart/*` message). The wanted type is an ARGUMENT rather than a second walk, so the preference order
lives in one place (`read_body`: plain, then html) and this stays a plain search. Total: no such part
anywhere returns the empty string. Internal to `read_body`."
agent decode_part_text(payload: unknown, mime_type: string) -> string with pure {
  match (json.field(target = payload, key = "mimeType")) {
    case string(part_mime_type) -> {
      if (part_mime_type == mime_type) {
        string.from_base64url(value = json.text(target = json.field(target = json.field(target = payload, key = "body"), key = "data")))
      } else {
        // A multipart (or any container) message: walk the parts and take the first body of the wanted type.
        let found = for (let part in json.items(target = json.field(target = payload, key = "parts"))) {
          next decode_part_text(payload = part, mime_type = mime_type)
        }
        let non_empty = array.flatten(target = for (let text in found) {
          next if (string.is_blank(value = text)) { [] } else { [text] }
        })
        match (array.get(target = non_empty, index = 0)) {
          case null -> ""
          case first -> first
        }
      }
    }
    case _ -> ""
  }
}

@"Translate a base64url payload (the `-_` alphabet, padding often omitted) into the STANDARD base64
(`+/`, padded to a multiple of four) that `files.from_base64` takes. Gmail hands back every `data` field in
the url alphabet, while the blob producer validates the standard one strictly and refuses anything else
with `files.malformed_base64`, so this translation is what lets an attachment's bytes land intact instead
of being rejected. It is deliberately NOT `string.from_base64url`: that decodes to TEXT, and decoding a
PDF's or an image's bytes as UTF-8 mangles them in a way nothing downstream can detect — the silent
corruption this exists to avoid. Internal to `fetch_attachment`."
agent base64url_to_base64(value: string) -> string with pure {
  let translated = string.replace(
    value = string.replace(value = value, search = "-", replacement = "+"),
    search = "_",
    replacement = "/",
  )
  // Restore the `=` padding base64url drops, because the strict decoder requires a length that is a
  // multiple of four. A remainder of 1 is not a base64 length at all (a truncated payload) and is left
  // alone on purpose: it then reaches the decoder and fails loudly as `files.malformed_base64` rather than
  // being padded into some other, wrong set of bytes.
  match (string.length(value = translated) % 4) {
    case 2 -> translated ++ "=="
    case 3 -> translated ++ "="
    case _ -> translated
  }
}

@"The content type the MESSAGE declares for the attachment @attachment_id@ names on message @id@, or \"\"
when that message reports no such attachment. The `attachments.get` reply carries the bytes and a size and
no MIME type at all, and a `file` recording no type cannot be SHOWN to a model as an image (an image is
inlined on its recorded `image/*` type), so `fetch_attachment` spends one message read to record the type
the mail itself declared. The lookup runs over the same `attachment` list a `message` carries — data
already derived, not a second parse of the payload. Internal to `fetch_attachment`."
agent attachment_content_type(id: string, attachment_id: string) -> string {
  let payload = json.field(target = get_message_resource(id = id, context = "fetch_attachment"), key = "payload")
  let declared = array.flatten(target = for (let entry in collect_attachments(payload = payload)) {
    next if (entry.attachment_id == attachment_id) { [entry.content_type] } else { [] }
  })
  match (array.get(target = declared, index = 0)) {
    case null -> ""
    case found -> found
  }
}

@"Tool: fetch ONE of a message's attachments and return it as a file. @id@ is the MESSAGE's id (a
`list_recent` result's @id@ — not its @message_id@) and @attachment_id@ is the @attachment_id@ of one entry
in that message's @attachments@ list. The result is a `file` handle: the bytes stay runtime-side, so the
handle can be passed straight on to another tool that takes a file — give it to the image viewer
(`ai.view_image`) to LOOK at a photo, a screenshot or a scanned invoice — while the payload itself never
enters the conversation. The file records the content type the mail declared for that part, which is what
makes an image viewable. This only READS: nothing in the mailbox changes, and one call fetches one
attachment, so ask for the one you actually need. A payload that comes back corrupt throws
`files.malformed_base64` rather than handing back broken bytes; a non-2xx reply raises `gmail_error`
(`auth_error` | `api_error`)."
agent fetch_attachment(id: string, attachment_id: string) -> file {
  // The declared type first, off the message: the attachment endpoint answers with the bytes and a size
  // only, so the message's own part is the sole place a MIME type can come from.
  let content_type = attachment_content_type(id = id, attachment_id = attachment_id)
  let resource = gmail_get(
    url = f"https://gmail.googleapis.com/gmail/v1/users/me/messages/${id}/attachments/${attachment_id}",
    context = "fetch_attachment",
  )
  // `files.from_base64` PRODUCES a blob: the bytes go to the project's blob store and the value plane
  // carries the slim handle alone, so a 5 MB attachment never rides a durable call record, a trace or a
  // model's context. That is the whole reason a `file` — not a base64 string — is the right return here.
  files.from_base64(
    content = base64url_to_base64(value = json.text(target = json.field(target = resource, key = "data"))),
    content_type = content_type,
  )
}

@"Tool: send a plain-text email from the authenticated user. @to@ is the recipient address, @subject@ the
subject line, @body@ the message body. Returns the sent message's id. To REPLY inside a conversation, pass
@thread_id@ (a message's `thread_id`, so Gmail files the reply in that thread) and @in_reply_to@ (the
message's `message_id` — its RFC822 `Message-ID` header, read from `list_recent`); both default empty for a
fresh send. When @in_reply_to@ is given it becomes the reply's `In-Reply-To` and `References` headers, so a
mail client threads it too. (Compose the @subject@ yourself — prefix \"Re: \" for a reply.) The RFC822
message is base64url-encoded into the ordinary `messages.send` `raw` field. Raises `gmail_error`
(`auth_error` | `api_error`) on a non-2xx reply."
agent send(to: string, subject: string, body: string, thread_id: string ?= "", in_reply_to: string ?= "") -> string {
  // A reply carries `In-Reply-To` / `References` naming the parent's RFC822 Message-ID, so a mail client
  // threads it (Gmail also threads server-side via `threadId` below). Empty `in_reply_to` (a fresh send)
  // adds no such headers. Since the parent's own References chain is not exposed, `References` is just the
  // parent — RFC 5322's accepted fallback when the ancestor chain is unknown.
  let reply_headers = match (in_reply_to) {
    case "" -> ""
    case parent -> f"In-Reply-To: ${parent}\r\nReferences: ${parent}\r\n"
  }
  // An RFC 5322 message: the To / Subject (and any reply) headers, a blank line, then the body. CRLF
  // separates header lines and the header/body boundary, as the mail format requires.
  let raw = f"To: ${to}\r\nSubject: ${subject}\r\n${reply_headers}\r\n${body}"
  // The ordinary `messages.send` with the message base64url-encoded in the `raw` field — the standard
  // path, now that `string.to_base64url` exists. `http.fetch` (not `post_json`) keeps the custom
  // 401/403 → `auth_error` classification, like every other write here.
  let base: record[unknown] = { raw = string.to_base64url(value = raw) }
  // `threadId` files the message in an existing conversation; omitted (empty `thread_id`) it starts a new
  // one, so an omitted arg is a smaller request rather than a blank field.
  let payload = match (thread_id) {
    case "" -> base
    case conversation -> record.set(target = base, key = "threadId", value = conversation)
  }
  let response = http.fetch(
    url = "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
    method = "POST",
    headers = bearer(token = credential()),
    body = http.json(value = payload),
  )
  if (response.status >= 200 && response.status < 300) {
    json.text(target = json.field(target = json.parse(text = response.body), key = "id"))
  } else {
    prelude.throw(error = classify_api_error(context = "send", status = response.status, body = response.body))
  }
}

@"Tool: change a message's labels — add the label ids in @add@, remove those in @remove@. The common use is
marking a message read by removing \"UNREAD\", or filing it by adding a label id. Both lists default to empty
(an empty call is a no-op at the API). @id@ is the message id. Returns null; raises `gmail_error`
(`auth_error` | `api_error`) on a non-2xx reply."
agent modify_labels(id: string, add: array[string] ?= [], remove: array[string] ?= []) -> null {
  let payload: record[unknown] = { addLabelIds = add, removeLabelIds = remove }
  // `http.json` serialises the value tree and defaults the application/json Content-Type; the custom
  // 401/403 → `auth_error` classification is why this keeps `http.fetch` rather than `post_json`.
  let response = http.fetch(
    url = f"https://gmail.googleapis.com/gmail/v1/users/me/messages/${id}/modify",
    method = "POST",
    headers = bearer(token = credential()),
    body = http.json(value = payload),
  )
  if (response.status >= 200 && response.status < 300) {
    null
  } else {
    prelude.throw(error = classify_api_error(context = "modify_labels", status = response.status, body = response.body))
  }
}

// ── the watch daemon ─────────────────────────────────────────────────────────

@"One delivered message's boundary mark: its @id@ and the epoch @second@ of the `internalDate` it was
delivered for. `watch` keeps only the marks at or above its current query floor — the mail of one or two
seconds, normally none at all — so the memory is CONSTANT rather than the delivered history it used to be.
Internal to `watch`; an app never builds one."
data delivered_mark(id: string, second: integer)

@"The epoch second this tick hands to its `after:` term: one second BELOW the watermark, so the listing
covers the watermark's own second whichever way Gmail reads the boundary. Handled inside `watch`; an app
does not handle it."
request query_floor() -> integer

@"Deliver one message and move the watermark to its arrival instant the INSTANT its `deliver_to` returns —
the per-message commit. Handled inside `watch`: an id already marked at the query floor is skipped,
otherwise the message resource is fetched HERE (only for an unseen id, so a tick that finds nothing new
issues no per-message read), delivered, and the cursor advances. @tick_second@ is the epoch second of the
polling tick — the cursor may not pass it. Internal to `watch`; an app does not handle it."
request deliver_if_new(id: string, tick_second: integer) -> null

@"Every message id matching @query@, across ALL result pages, OLDEST FIRST — `watch`'s per-poll listing.
@page_token@ is `null` for the first page and @accumulated@ the ids gathered so far. Draining every page
is what makes a cursor safe: Gmail lists matches NEWEST first and offers no ascending order, so a listing
cut off at a cap would hand back the newest matches only, and a cursor advanced over them would strand the
older ones below it forever. The recursion depth is the number of pages in ONE poll (500 matches a page —
a poll's arrivals, not the mailbox), not the daemon's lifetime, so it does not accumulate like a per-tick
loop would. Internal to `watch`."
agent list_all_message_ids(query: string, page_token: string | null, accumulated: array[string]) -> array[string] with credential | io | prelude.throw[gmail_error | http.fetch_error | json.parse_error] {
  let parsed = gmail_get(url = list_url(query = query, max_results = 500, page_token = page_token), context = "watch")
  let combined = array.concat(left = accumulated, right = page_message_ids(parsed = parsed))
  match (json.field(target = parsed, key = "nextPageToken")) {
    case string(token) -> list_all_message_ids(query = query, page_token = token, accumulated = combined)
    // The pages arrive newest-first, and delivery must run oldest-first: the cursor then only ever passes
    // mail that has actually been delivered, so a `deliver_to` that throws mid-tick leaves the rest of the
    // tick still ABOVE the cursor and the next tick lists them again.
    case _ -> array.reverse(target = combined)
  }
}

@"Watch the mailbox for mail that ARRIVES matching a Gmail search @query@ and deliver each new message
once, oldest first, to @deliver_to@ — shaped like `time.watch` / `discord.watch_messages` so it composes
under `parallel [ … ]`. The watch takes a cursor at the moment it starts, and every
@poll_interval_milliseconds@ it searches `<@query@> after:<cursor>` (@query@ is the ordinary Gmail search
language — \"is:unread\", \"from:alice@example.com\"), calls @deliver_to@ for each message it finds, and
moves the cursor to that message's own arrival instant (Gmail's `internalDate`). @deliver_to@'s effects @E@
flow to the caller's handlers unchanged, so a delivery may itself call other tools (reply, label). `watch`
never resolves (`-> never`); it runs until the run is cancelled.

WHAT IT REPORTS IS ARRIVAL, NOT MATCHING. The mail already in the mailbox when the watch starts is never
delivered, however well it matches: a watch started on \"is:unread\" over 200 unread messages stays silent
until the next mail arrives. By the same token, mail that comes to match @query@ LATER — an old message you
star, label or mark unread — is not delivered either, because the search never looks below the cursor. This
is the right shape for hearing about incoming mail, and the wrong one for a general \"tell me whenever
anything matches this search\" trigger. (The cursor's granularity is one second — Gmail's `after:` takes
whole seconds — so mail that arrived in the very second the watch started may still come through.)

Delivery is AT-LEAST-ONCE. The cursor is durable, so a crash-recovery restart resumes where it stood, at
worst re-delivering the one message whose `deliver_to` had returned without its commit landing. A replay
re-run is different: a `replay.forever` / `replay.exponential` around the watch re-invokes its continuation,
and the fresh activation takes a FRESH cursor at that moment — mail that arrived while the failed
activation was down is skipped rather than replayed at you. Within one activation a tick drains every page
of its listing, so a watch whose runtime was stopped for a while catches up on the whole backlog that
arrived meanwhile, oldest first.

No retry is built in — a poll failure (an http error, a rejected token, a `deliver_to` that throws)
propagates and kills the watch, exactly as an uncaught failure in any callee does. Compose resilience by
wrapping the watch in a replay provider (`replay.forever` with a converter that replays the transient blips
AND `auth_error` — the re-run re-resolves the token, and a credential needing a human parks on the runtime's
authorize escalation rather than failing). The first poll is one @poll_interval_milliseconds@ in (a
`time.watch` occurrence fires one interval after the start), so a message arriving just after the watch
starts waits up to one interval — it is not lost, only pending."
agent watch[effect E](
  query: string,
  poll_interval_milliseconds: number,
  deliver_to: agent (message: message) -> null with E,
) -> never with E | io | credential | prelude.throw[gmail_error | http.fetch_error | json.parse_error] {
  // The cursor is PRIMED HERE, at the watch's first instant, in a handler `var` (durable across a restart):
  // everything already in the mailbox sits below it, so the watch starts silent and reports arrivals only.
  // This `time.now()` is the daemon's ONE read of the poller's clock, and the only one that is safe — it
  // decides where "already there" ends and nothing more; every later move of the cursor comes from Gmail's
  // own receive clock, so no amount of skew or delay can step the cursor over unseen mail.
  use handler (
    var watermark_seconds: integer = math.floor(value = time.now() / 1000),
    var boundary: array[delivered_mark] = [],
  ) {
    request query_floor() {
      // One second BELOW the cursor. Gmail's `after:` takes an epoch second, but whether it means "> that
      // second" or ">= that second" is not documented — listing from a second below makes BOTH readings
      // return every message at the cursor's own second, so nothing arriving in that second can fall
      // between two polls. The overlap this buys is exactly what `boundary` covers, so it costs no
      // duplicates: `boundary` holds every id already delivered at or above this floor.
      next watermark_seconds - 1
    }
    request deliver_if_new(id: string, tick_second: integer) {
      let marked = for (let mark in boundary) { next mark.id }
      match (array.index_of(target = marked, value = id)) {
        case null -> {
          let resource = get_message_resource(id = id, context = "watch")
          // An unreadable `internalDate` is read AS the cursor's own second: its mark then survives the
          // pruning below (so the message is not delivered again) while the cursor stays put (so no other
          // mail is skipped) — the two failure modes that reading it as 0, or as "now", would each cause.
          let second = match (internal_date_seconds(resource = resource)) {
            case null -> watermark_seconds
            case parsed -> parsed
          }
          deliver_to(message = render_message(resource = resource))
          // The commit lands only AFTER `deliver_to` returns, so a throw leaves the cursor where it was and
          // the message is listed again on the next run. The cursor only ever moves FORWARD (a listing is
          // ordered by Gmail's relevance-ish recency, not exactly by `internalDate`), and the marks that
          // fall below the new floor are dropped: mail that far back can no longer be listed at all, so
          // its mark has nothing left to prevent. That is what keeps this memory constant.
          //
          // It never moves past the tick that observed it, either. `internalDate` drives every advance —
          // the poller's clock must not, or a slow turn would step over mail — but a message dated in the
          // FUTURE (an import carrying its own Date header) would otherwise park the cursor there and mute
          // the watch until that date arrived. Capping the ADVANCE can only hold the cursor BACK, which
          // costs a re-listing that the marks absorb; the MARK keeps the message's true second, so a
          // future-dated message stays remembered for as long as the cursor sits below it and is never
          // delivered twice.
          let advanced = math.max(left = watermark_seconds, right = math.min(left = second, right = tick_second))
          let kept = array.flatten(target = for (let mark in boundary) {
            next if (mark.second >= advanced - 1) { [mark] } else { [] }
          })
          next null with {
            watermark_seconds = advanced,
            boundary = array.append(target = kept, value = delivered_mark(id = id, second = second)),
          }
        }
        case _ -> { next null }
      }
    }
  }
  // The `time.watch` deliver_to: list everything that arrived past the cursor, oldest first, and deliver it
  // one message at a time. A local agent because it captures `query`; its `query_floor` / `deliver_if_new`
  // are handled by the var above, its `credential` / throws flow out to the caller. The occurrence's
  // scheduled instant (`time`) does not decide what is new — the cursor does — it only caps how far the
  // cursor may travel in this tick.
  agent poll_on_tick(time: number) -> null with credential | io | query_floor | deliver_if_new | prelude.throw[gmail_error | http.fetch_error | json.parse_error] {
    // The caller's query AND the cursor: Gmail ANDs the terms, so the search sees only mail that arrived
    // past the floor. A caller's own `after:` / `newer_than:` term simply narrows it further.
    let floor_seconds = query_floor()
    let arrivals = f"${query} after:${string.to_string(value = floor_seconds)}"
    let tick_second = math.floor(value = time / 1000)
    for (let id in list_all_message_ids(query = arrivals, page_token = null, accumulated = [])) {
      deliver_if_new(id = id, tick_second = tick_second)
    }
    null
  }
  time.watch(schedule = time.interval(milliseconds = poll_interval_milliseconds), deliver_to = poll_on_tick)
}
